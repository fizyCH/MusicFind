# Copy this file to ".env" and fill in your values.
# The server reads it on startup (see main.py -> load_env()).

# --- HTTP server ---
HOST=0.0.0.0
PORT=8081

# Password for the /admin panel. CHANGE IT.
ADMIN_PASSWORD=change-me

# --- OTA (in-app update) ---
# Path to the Android APK that the app downloads. Put your built APK here.
APP_APK_PATH=/opt/musicfind/server/data/app/MusicFind.apk

# Automatically update yt-dlp/ffmpeg in the background (1 = on, 0 = off).
AUTO_UPDATE=1
AUTO_UPDATE_INTERVAL_SECONDS=86400

# --- Optional: yt-dlp / SoundCloud cookies ---
# Place cookie files at server/data/yt_cookies.txt and server/data/sc_cookies.txt
# to access age/region restricted content.
